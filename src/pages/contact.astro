---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { site } from '@/data/site';

const otherLinks = [
  { label: 'LinkedIn', href: site.linkedin, hint: 'in/amardeep-dhillon', external: true },
  { label: 'GitHub', href: site.github, hint: 'github.com/adhillon192', external: true },
  { label: 'Resume', href: site.resume, hint: 'PDF', download: true },
  // Points at the on-site links hub. Swap `site.links` for an external
  // linktr.ee/... URL here if you'd rather send people to that instead.
  { label: 'All links', href: site.links, hint: 'adhillon.net/links' },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Amardeep Dhillon. Open to consulting and technical delivery work."
>
  <header class="pb-8 sm:pb-10">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contact</h1>
    <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-[var(--color-ink-soft)] text-pretty">
      I'm open to consulting work: automating a manual process, a marketplace or storefront
      build, or a technical audit. Email is the best way to reach me.
    </p>
  </header>

  <Section label="Email">
    <a href={`mailto:${site.email}`} class="link text-xl font-medium sm:text-2xl">{site.email}</a>
    <p class="meta mt-2">{site.location}</p>
  </Section>

  <Section label="Elsewhere">
    <ul class="rows -mt-1">
      {
        otherLinks.map((l) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <a
              href={l.href}
              class="link"
              download={l.download ? '' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
            >
              {l.label}
            </a>
            <span class="meta">{l.hint}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
