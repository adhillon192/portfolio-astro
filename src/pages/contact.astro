---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

// Contact methods as large, tappable cards. Resume lives here (as a download)
// now that it's no longer a top-level nav tab.
const methods = [
  {
    icon: 'mail' as const,
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    copy: site.email,
  },
  {
    icon: 'linkedin' as const,
    label: 'LinkedIn',
    value: 'in/amardeep-dhillon',
    href: site.linkedin,
    external: true,
  },
  {
    icon: 'github' as const,
    label: 'GitHub',
    value: 'github.com/adhillon192',
    href: site.github,
    external: true,
  },
  {
    icon: 'file' as const,
    label: 'Resume',
    value: 'Download PDF',
    href: '/resume.pdf',
    download: true,
  },
  {
    icon: 'link' as const,
    label: 'All my links',
    value: 'Linktree',
    // Points at the on-site links hub. Swap `site.links` for an external
    // linktr.ee/... URL here if you'd rather send people to that instead.
    href: site.links,
  },
];
---

<BaseLayout title="Contact" description="Get in touch with Amardeep Dhillon — open to consulting and technical delivery work.">
  <header class="mb-10">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-xs font-medium text-[var(--color-accent-ink)]"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
      </span>
      Open to consulting
    </span>

    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Let's build something.
    </h1>
    <p class="mt-4 max-w-xl text-lg text-[var(--color-ink-soft)] text-pretty">
      Whether it's automating a manual process, a marketplace or storefront build, or
      technical consulting — send a note and I'll get back to you.
    </p>
    <p class="mt-3 flex items-center gap-2 text-sm text-[var(--color-ink-faint)]">
      <Icon name="pin" class="h-4 w-4" />
      {site.location} · usually replies within a day
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      methods.map((m) => (
        <a
          href={m.href}
          download={m.download ? '' : undefined}
          rel={m.external ? 'noopener noreferrer' : undefined}
          class="card group flex items-center gap-4 p-5 transition-colors hover:border-[var(--color-ink)]"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-base)] text-[var(--color-ink)] transition-colors group-hover:bg-[var(--color-accent-soft)] group-hover:text-[var(--color-accent-ink)]">
            <Icon name={m.icon} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-[var(--color-ink)]">{m.label}</span>
            <span class="block truncate text-sm text-[var(--color-ink-soft)]">{m.value}</span>
          </span>
          <span class="text-[var(--color-ink-faint)] transition-colors group-hover:text-[var(--color-ink)]">
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </span>
        </a>
      ))
    }
  </div>

  <!-- Quick copy-email row -->
  <div
    class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-[var(--radius-card)] bg-[var(--color-ink)] px-5 py-4 text-white"
  >
    <span class="text-sm">
      Prefer to copy it? <span class="font-medium">{site.email}</span>
    </span>
    <button
      id="copy-email"
      type="button"
      data-email={site.email}
      class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-white/20"
    >
      <Icon name="copy" class="h-4 w-4" />
      <span data-copy-label>Copy email</span>
    </button>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('copy-email');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
  btn?.addEventListener('click', async () => {
    const email = btn.getAttribute('data-email') ?? '';
    try {
      await navigator.clipboard.writeText(email);
      if (label) {
        const original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => (label.textContent = original), 1600);
      }
    } catch {
      // Clipboard blocked (e.g. insecure context) — fall back to a mailto.
      window.location.href = `mailto:${email}`;
    }
  });
</script>
