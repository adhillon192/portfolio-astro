---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
  Ideas & Archive page (Spec §6a). Two clearly separated sections. Static, no
  backend. Page title is a PLACEHOLDER — naming is still open ("wall of shame"
  vs. alternatives); do not hardcode a final name. No real entries written yet,
  so this is structural only (Spec §6a: template until real entries exist).
*/
const ideas: { title: string; note: string }[] = [
  // Real entries go here: { title: '...', note: 'what it is + why worth building' }
];

const archive: { title: string; date: string; note: string }[] = [
  // Early / learning projects kept for the growth narrative, one line + date each.
];
---

<BaseLayout title="Ideas & Archive" description="Unbuilt ideas worth existing, and early work kept for the growth story.">
  <header class="mb-10">
    <!-- PLACEHOLDER title — final naming undecided (reference doc). -->
    <h1 class="text-3xl font-semibold tracking-tight">Ideas &amp; Archive</h1>
    <p class="mt-3 text-[var(--color-ink-soft)]">
      Two things: ideas I think should exist but haven't built, and early work kept
      for the growth story rather than the polish.
    </p>
  </header>

  <section class="mb-12">
    <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-ink-faint)]">
      Ideas — unbuilt
    </h2>
    {
      ideas.length === 0 ? (
        <p class="mt-4 rounded-lg border border-dashed border-[var(--color-border-strong)] p-6 text-sm text-[var(--color-ink-faint)]">
          No entries yet. Each idea gets a title and a sentence or two on why it'd be
          worth building.
        </p>
      ) : (
        <ul class="mt-4 flex flex-col gap-4">
          {ideas.map((idea) => (
            <li class="card p-5">
              <h3 class="font-medium text-[var(--color-ink)]">{idea.title}</h3>
              <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{idea.note}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-ink-faint)]">
      Archive — early work
    </h2>
    {
      archive.length === 0 ? (
        <p class="mt-4 rounded-lg border border-dashed border-[var(--color-border-strong)] p-6 text-sm text-[var(--color-ink-faint)]">
          No entries yet. Older or early projects worth preserving for the growth
          narrative — one line and a rough date each.
        </p>
      ) : (
        <ul class="mt-4 flex flex-col gap-3">
          {archive.map((item) => (
            <li class="flex flex-wrap items-baseline gap-x-3 border-b border-[var(--color-border)] pb-3 text-sm">
              <span class="font-medium text-[var(--color-ink)]">{item.title}</span>
              <span class="text-[var(--color-ink-faint)]">{item.date}</span>
              <span class="w-full text-[var(--color-ink-soft)] sm:w-auto">{item.note}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
