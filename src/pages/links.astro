---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, contactLinks, projects } from '@/data/site';

// Standalone shareable link page — the linktree alternative (Spec §3).
// Decided destination is links.adhillon.net; served here as /links until the
// subdomain DNS is configured on the host. Deliberately minimal / single-column.
const linkRows = [
  ...contactLinks.map((l) => ({ label: l.label, hint: l.hint, href: l.href })),
  ...projects.map((p) => ({
    label: p.name,
    hint: p.live.replace('https://', ''),
    href: p.live,
  })),
];
---

<BaseLayout title="Links" description="All of Amardeep Dhillon's links in one place.">
  <div class="mx-auto max-w-md">
    <h1 class="text-2xl font-semibold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-[var(--color-ink-soft)]">{site.tagline}</p>

    <ul class="rows mt-8">
      {
        linkRows.map((row) => (
          <li>
            <a
              href={row.href}
              rel={row.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="group flex items-baseline justify-between gap-x-4 py-4 transition-colors hover:text-[var(--color-accent-ink)]"
            >
              <span class="font-medium">{row.label}</span>
              <span class="meta">{row.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8">
      <a href="/" class="link text-sm">Back to the site</a>
    </p>
  </div>
</BaseLayout>
