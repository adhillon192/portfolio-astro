---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { credentials, wcc } from '@/data/site';

// Career narrative (Spec §7). No military/PR intent stated on this page (Spec §7).
const experience = [
  {
    role: wcc.role,
    org: wcc.org,
    period: wcc.period,
    detail:
      'Cross-functional workflow automation across Admissions, Registrar, Records, Marketing and Finance at a 300-plus staff, roughly $50M a year institution. Coding, technical consulting for internal stakeholders, and project coordination.',
  },
  {
    role: 'Software Developer (casual, remote)',
    org: 'DentHire',
    period: 'Jan 2026 – Apr 2026',
    detail:
      'Full-stack development on a dental staffing platform: job postings, candidate matching and practice management. React and Node.js, working with product, design and business teams.',
  },
  {
    role: 'Content Developer',
    org: 'City of Calgary',
    period: 'Jan 2024 – Jul 2024',
    detail:
      'Coordinated the operational launch of a Technology Integration Center in the Smart Cities division. Liaised between city officials, technology vendors and community stakeholders, and produced AR/VR emerging-technology research and briefings for decision-makers.',
  },
  {
    role: 'Campaign Lead',
    org: 'Student Changemaker Network',
    period: 'Sep 2023 – Sep 2024',
    detail:
      'Led campus sustainability initiatives, maintained relationships with 15-plus internal and external stakeholders, and ran media and communications strategy.',
  },
] as const;

// Degrees are listed under Education; everything else under Certifications.
const isDegree = (label: string) => label.startsWith('B.Sc.') || label.startsWith("Master's");
const education = credentials.filter((c) => isDegree(c.label));
const certs = credentials.filter((c) => !isDegree(c.label));
const status = (c: (typeof credentials)[number]) =>
  [c.org, c.status === 'in progress' ? 'In progress' : null].filter(Boolean).join(' · ');
---

<BaseLayout
  title="About"
  description="Education, certifications, and a career narrative bridging technical execution and business problem-solving."
>
  <header class="pb-8 sm:pb-10">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">About</h1>
    <div class="mt-5 max-w-xl space-y-4 text-[17px] leading-relaxed text-[var(--color-ink-soft)] text-pretty">
      <p>
        I'm a Technical Consultant in Risk and Compliance at Western Community College, a
        300-plus staff institution with about $50M in annual revenue. The work is hands-on:
        coding, automation and technical consulting for people inside the college, approached
        with governance in mind rather than bolted on afterwards.
      </p>
      <p>I also run Fairhand, a small technology studio.</p>
    </div>
  </header>

  <Section label="Education">
    <ul class="rows -mt-1">
      {
        education.map((c) => (
          <li class="py-3">
            <p class="leading-snug">{c.label}</p>
            <p class="meta mt-0.5">{status(c)}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section label="Certifications">
    <ul class="rows -mt-1">
      {
        certs.map((c) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <p class="leading-snug">{c.label}</p>
            {status(c) && <p class="meta">{status(c)}</p>}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section label="Experience">
    <ol class="rows -mt-1">
      {
        experience.map((job) => (
          <li class="grid gap-y-1 py-4 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8">
            <p class="meta md:pt-0.5">{job.period}</p>
            <div>
              <h3 class="font-medium leading-snug">{job.role}</h3>
              <p class="meta mt-0.5">{job.org}</p>
              <p class="mt-2 max-w-lg text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {job.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    {/* PROVISIONAL — Community Support Worker line (Alex Community Centre, Jul–Dec 2025)
        intentionally omitted pending the include/exclude decision (Spec §7 / Open Items).
        Add here as one row if the reliability/service angle is wanted. */}
  </Section>

  <!-- Deliberately low-key and hard to discover; don't move it (knowledge-base.md §1). -->
  <p class="mt-10 text-xs text-[var(--color-ink-faint)]">
    I also coach 1-on-1 dating communication on the side:
    <a href="https://datingcoach.adhillon.net" rel="noopener noreferrer" class="link">datingcoach.adhillon.net</a>.
  </p>
</BaseLayout>
