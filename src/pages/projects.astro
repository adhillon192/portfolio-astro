---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { hackathons, wcc } from '@/data/site';

/**
 * Case studies, written as short prose rather than a labelled template.
 * Facts are unchanged from the locked copy (knowledge-base.md); only the
 * framing moved from "Problem / What was built / Current state" to paragraphs.
 */
const caseStudies = [
  {
    kind: 'Venture',
    name: 'Finlador',
    year: 'Feb 2025',
    role: 'Founding Engineer, equity held via Fairhand',
    live: 'https://finlador.com',
    paragraphs: [
      'Outdoor guides and outfitters running high-value hunting trips, around $5K a week, had no dedicated marketplace for reaching serious clients. It is a niche market where quality matters more than volume.',
      'I built the marketplace end to end: real-time messaging and presence over Ably, automated email notifications, role-based profiles with row-level security, public profiles built for search, cloud media uploads, and server-rendered auth with OAuth.',
      // PROVISIONAL — open question in reference doc: whether any booking/transaction
      // has occurred, or it's connection/messaging only. Framed conservatively here.
      'Fifty curated members so far. The positioning is refinement over headcount; in this market a single connection can be worth thousands.',
    ],
    stack: ['Next.js', 'TypeScript', 'Tailwind', 'Postgres', 'Ably'],
  },
  {
    kind: 'Client work',
    name: 'Velarisse Leather',
    year: 'Jan 2025',
    role: null,
    live: 'https://velarisseleather.com',
    paragraphs: [
      'A handcrafted leather goods brand needed a proper storefront to sell online, with the cart, tax and shipping handled correctly rather than a template with a buy button.',
      'I built the e-commerce platform: shopping cart, real-time tax calculation, multiple shipping options, product filtering and search by category, price and attributes, and a secure payment gateway integration.',
      'Live storefront for the client brand.',
    ],
    stack: ['Next.js', 'TypeScript', 'Tailwind'],
  },
  {
    kind: 'Prototype',
    name: 'Priorcheck',
    year: 'In progress',
    role: null,
    live: null,
    paragraphs: [
      'Cross-platform social graph risk analysis: checking someone across the platforms where they actually have a presence, instead of cross-referencing each one by hand.',
      'Today it is a demand-testing landing page rather than a shipped product. I am validating interest before building the data pipeline and classification approach behind it.',
      'It is being designed around platform terms of service and scraping-policy constraints from the start, not retrofitted to them.',
    ],
    stack: [],
  },
] as const;
---

<BaseLayout
  title="Projects"
  description="Case studies: Finlador, Velarisse Leather, Priorcheck, and consulting work at Western Community College."
>
  <header class="pb-8 sm:pb-10">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mt-4 max-w-xl text-[17px] text-[var(--color-ink-soft)]">
      What I have built or delivered, and where each one stands.
    </p>
  </header>

  <!-- Western Community College: kept modest on purpose. See the note on `wcc` in site.ts. -->
  <Section label="Current role">
    <h2 class="text-xl font-medium leading-snug">{wcc.org}</h2>
    <p class="meta mt-1">{wcc.period} · {wcc.role}</p>
    <p class="mt-4 max-w-lg text-[var(--color-ink-soft)]">{wcc.summary}</p>

    <dl class="mt-6 grid max-w-md grid-cols-2 gap-x-8">
      {
        wcc.kpis.map((kpi) => (
          <div class="border-t border-[var(--color-border-strong)] pt-2.5">
            <dt class="figure text-2xl leading-none">{kpi.value}</dt>
            <dd class="mt-1.5 text-[13px] leading-snug text-[var(--color-ink-soft)]">{kpi.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="meta mt-6">{wcc.tags.join(' · ')}</p>
  </Section>

  {
    caseStudies.map((cs) => (
      <Section label={cs.kind}>
        <article>
          <h2 class="text-xl font-medium leading-snug">
            {cs.live ? (
              <a href={cs.live} rel="noopener noreferrer" class="link">
                {cs.name}
              </a>
            ) : (
              cs.name
            )}
          </h2>
          <p class="meta mt-1">
            {[cs.year, cs.role, cs.live?.replace('https://', '')].filter(Boolean).join(' · ')}
          </p>
          <div class="mt-4 max-w-lg space-y-4 text-[var(--color-ink-soft)]">
            {cs.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          {cs.stack.length > 0 && <p class="meta mt-6">{cs.stack.join(' · ')}</p>}
        </article>
      </Section>
    ))
  }

  <!-- Hackathons: one row each, below the case studies (Spec §6). -->
  <Section label="Hackathons">
    <ul class="rows -mt-1">
      {
        hackathons.map((h) => (
          <li class="py-3">
            <p class="flex flex-wrap items-baseline justify-between gap-x-4">
              {h.live ? (
                <a href={h.live} rel="noopener noreferrer" class="link font-medium">
                  {h.name}
                </a>
              ) : (
                <span class="font-medium">{h.name}</span>
              )}
              <span class="meta">
                {h.event} · {h.year}
              </span>
            </p>
            <p class="mt-1 text-[15px] text-[var(--color-ink-soft)]">{h.oneLiner}</p>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
