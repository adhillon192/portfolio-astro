---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { site, credentials, contactLinks, wcc, fairhand } from '@/data/site';
---

<BaseLayout title="Amardeep Dhillon — Technical Consultant" brandSuffix={false}>
  <!--
    The page reads top to bottom as a short document: who, what now, what backs
    it up, and where to go next. No tiles, no badges. Credentials keep their
    own ruled section near the top per Amardeep's request that they carry
    weight (knowledge-base.md, 2026-08-23 (a)).
  -->
  <header class="pb-10 sm:pb-14">
    <h1 class="max-w-2xl text-[1.7rem] leading-[1.25] tracking-tight text-balance sm:text-[2.35rem]">
      I'm Amardeep Dhillon, a technical consultant in Vancouver working on risk, compliance and
      workflow automation.
    </h1>
    <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-[var(--color-ink-soft)] text-pretty">
      Right now that's at {wcc.org}, where I automate internal workflows and run technical
      audits of the college's systems. Before this I was at the City of Calgary. I hold CompTIA
      Security+ and a degree in computer information systems, and I take on consulting work
      alongside the role.
    </p>
    <p class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-[15px] font-medium">
      <a href="/projects" class="link">View work</a>
      <a href="/contact" class="link">Get in touch</a>
    </p>
  </header>

  <Section label="Currently">
    <h3 class="font-medium leading-snug">{wcc.role}, {wcc.org}</h3>
    <p class="meta mt-1">{wcc.period}</p>
    <p class="mt-3 max-w-lg text-[var(--color-ink-soft)]">{wcc.summary}</p>

    <!-- Scale, not outcomes. See the note on `wcc` in site.ts. -->
    <dl class="mt-6 grid max-w-md grid-cols-2 gap-x-8">
      {
        wcc.kpis.map((kpi) => (
          <div class="border-t border-[var(--color-border-strong)] pt-2.5">
            <dt class="figure text-2xl leading-none">{kpi.value}</dt>
            <dd class="mt-1.5 text-[13px] leading-snug text-[var(--color-ink-soft)]">{kpi.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="meta mt-6">{wcc.tags.join(' · ')}</p>
  </Section>

  <Section label="Credentials">
    <ul class="rows -mt-1">
      {
        credentials.map((c) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="leading-snug">{c.label}</p>
              {(c.org || c.status === 'in progress') && (
                <p class="meta mt-0.5">
                  {[c.org, c.status === 'in progress' ? 'In progress' : null]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              )}
            </div>
            {c.logo && (
              <img
                src={c.logo}
                alt=""
                class="h-8 w-8 shrink-0 object-contain mix-blend-multiply"
                loading="lazy"
              />
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- The studio, not a "project": Finlador's equity sits here. Projects live on /projects. -->
  <Section label="Studio">
    <h3 class="font-medium leading-snug">{fairhand.name}</h3>
    <p class="meta mt-1">{fairhand.role}</p>
    <p class="mt-3 max-w-lg text-[var(--color-ink-soft)]">
      A small technology studio, and the founding entity behind
      <a href="/projects" class="link">Finlador</a>.
    </p>
  </Section>

  <Section label="Elsewhere">
    <ul class="rows -mt-1">
      {
        contactLinks.map((link) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <a
              href={link.href}
              class="link"
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
            <span class="meta">{link.hint}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
