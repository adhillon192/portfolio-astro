---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BentoCard from '@/components/BentoCard.astro';
import Icon from '@/components/Icon.astro';
import { site, credentials, contactLinks, wcc, fairhand } from '@/data/site';

// Quiet supporting-facts line under the hero tagline — plain text, not another
// row of pills, so it doesn't read as credential-stacking (reference doc
// Flaw #4) right under the name. Backs up the tagline's security/governance
// angle with concrete facts: cert, sector, and prior public-sector experience.
const heroCredibility = [
  'CompTIA Security+',
  'Confidential systems in education',
  'Previously City of Calgary',
];
---

<BaseLayout title="Amardeep Dhillon — Technical Consultant" brandSuffix={false} wide>
  <!--
    Bento grid (Spec §5). 4 columns on desktop, single stacked column on mobile.
    Tiles are ordered by priority so the mobile stack keeps the same reading order.
  -->
  <div class="grid grid-cols-1 gap-4 md:grid-cols-4 md:auto-rows-[minmax(0,auto)] md:grid-flow-row-dense">
    <!-- 1. Hero (largest) -->
    <BentoCard span={2} rows={2} class="justify-between">
      <div>
        <div class="flex flex-wrap gap-2">
          <span
            class="rounded-full border border-[var(--color-border-strong)] px-2.5 py-0.5 text-xs text-[var(--color-ink-soft)]"
          >
            {site.location}
          </span>
          <span
            class="rounded-full bg-[var(--color-accent-soft)] px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent-ink)]"
          >
            Open to consulting
          </span>
        </div>
        <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
          {site.name}
        </h1>
        <p class="mt-4 max-w-md text-lg text-[var(--color-ink-soft)] text-pretty">
          {site.tagline}
        </p>
        <p class="mt-3 max-w-md text-xs text-[var(--color-ink-faint)]">
          {heroCredibility.join(' · ')}
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="rounded-lg bg-[var(--color-ink)] px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
        >
          View work
        </a>
        <a
          href="/about"
          class="rounded-lg border border-[var(--color-border-strong)] px-4 py-2 text-sm font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-ink)]"
        >
          About
        </a>
      </div>
    </BentoCard>

    <!-- 2. Current work / WCC — strongest tile, real visual weight -->
    <BentoCard span={2} rows={2} eyebrow="Current work" class="justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Western Community College</h2>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
          Technical Consultant — Risk & Compliance at a 300+ staff, ~$50M/yr institution —
          workflow automation and systems audits, plus some website work on the side.
        </p>

        <!-- KPI callouts (replaces the long paragraph) -->
        <dl class="mt-5 grid grid-cols-2 gap-3">
          {
            wcc.kpis.map((kpi) => (
              <div class="rounded-lg bg-[var(--color-base)] p-3">
                <dt class="text-2xl font-semibold tracking-tight text-[var(--color-ink)]">
                  {kpi.value}
                </dt>
                <dd class="mt-0.5 text-xs leading-snug text-[var(--color-ink-soft)]">
                  {kpi.label}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Technical tags (replaces the department pills) -->
      <ul class="mt-5 flex flex-wrap gap-1.5 text-xs text-[var(--color-ink-faint)]">
        {
          wcc.tags.map((tag) => (
            <li class="rounded bg-[var(--color-base)] px-2 py-0.5">{tag}</li>
          ))
        }
      </ul>
    </BentoCard>

    <!-- 3. Credentials — promoted to a wide, icon-badge tile (was a small text-pill
         row) so certifications carry real visual weight, not an afterthought.
         Placed right after WCC per Amardeep's direct request to lead with these. -->
    <BentoCard span={3} eyebrow="Credentials">
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-3">
        {
          credentials.map((c) => (
            <li class="flex items-center gap-3 rounded-lg bg-[var(--color-base)] p-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center">
                {c.logo ? (
                  <img
                    src={c.logo}
                    alt={`${c.org ?? c.label} logo`}
                    class="h-10 w-10 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]">
                    <Icon name={c.icon} class="h-5 w-5" />
                  </span>
                )}
              </span>
              <div class="min-w-0">
                <p class="text-sm font-medium text-[var(--color-ink)]">{c.label}</p>
                {(c.org || c.status === 'in progress') && (
                  <p class="text-xs text-[var(--color-ink-faint)]">
                    {[c.org, c.status === 'in progress' ? 'In progress' : null]
                      .filter(Boolean)
                      .join(' · ')}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </BentoCard>

    <!-- 4. Fairhand — the studio, not a "Project": different eyebrow, no stack
         tags/live link since it's an entity, not a shipped build. Projects
         (including Velarisse) live on /projects, not the homepage bento. -->
    <BentoCard span={2} eyebrow="Studio" class="justify-between">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">{fairhand.name}</h2>
        <p class="mt-1 text-xs font-medium text-[var(--color-accent-ink)]">{fairhand.role}</p>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{fairhand.oneLiner}</p>
      </div>
    </BentoCard>

    <!-- 5. Now (small) -->
    <BentoCard eyebrow="Now">
      <ul class="flex flex-col gap-3 text-sm text-[var(--color-ink-soft)]">
        <li>
          <span class="text-[var(--color-ink-faint)]">Reading</span><br />
          <!-- PROVISIONAL — specific title not yet confirmed (Spec §9); category
               (philosophy) is confirmed, so used here instead of a generic placeholder. -->
          <span class="text-[var(--color-ink)]">Philosophy (title TBD)</span>
        </li>
      </ul>
    </BentoCard>

    <!-- 6. Contact / linktree (small) — icon per link -->
    <BentoCard eyebrow="Contact">
      <ul class="flex flex-col gap-2.5 text-sm">
        {
          contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-2.5 text-[var(--color-ink)]"
              >
                <span class="text-[var(--color-ink-soft)] transition-colors group-hover:text-[var(--color-accent-ink)]">
                  <Icon name={link.icon} class="h-4 w-4" />
                </span>
                <span class="link-underline">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </BentoCard>

    <!-- 7. Personality (small, lowest priority) -->
    <BentoCard eyebrow="On repeat">
      <!-- PROVISIONAL — Spotify "now playing" embed or a static track (Spec §5). -->
      <p class="text-sm text-[var(--color-ink-soft)]">
        A track goes here — a small Spotify embed or a static “on repeat” line.
      </p>
    </BentoCard>
  </div>
</BaseLayout>
