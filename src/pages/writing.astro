---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';

// One "Writing" hub over two separate collections (toggle below). Routes stay
// distinct (/blog/*, /journal/*) so the journal can still be gated later.
const technical = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const personal = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Deep-link support: /writing?tab=personal opens the personal tab directly.
const initialTab = Astro.url.searchParams.get('tab') === 'personal' ? 'personal' : 'technical';
---

<BaseLayout title="Writing" description="Technical write-ups and personal notes.">
  <header class="pb-8 sm:pb-10">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Writing</h1>
    <p class="mt-4 max-w-xl text-[17px] text-[var(--color-ink-soft)]">
      Project write-ups and technical notes, and a separate journal for everything else.
    </p>
  </header>

  <!-- Plain text tabs; the selected one carries the oxblood rule. -->
  <div
    role="tablist"
    aria-label="Writing sections"
    class="mb-8 flex gap-x-6 border-b border-[var(--color-border)] text-[15px]"
  >
    <button
      id="tab-technical"
      role="tab"
      data-tab="technical"
      aria-selected={initialTab === 'technical'}
      aria-controls="panel-technical"
      class="tab-btn -mb-px border-b-2 pb-2.5 transition-colors"
    >
      Technical
    </button>
    <button
      id="tab-personal"
      role="tab"
      data-tab="personal"
      aria-selected={initialTab === 'personal'}
      aria-controls="panel-personal"
      class="tab-btn -mb-px border-b-2 pb-2.5 transition-colors"
    >
      Journal
    </button>
  </div>

  <!-- The tab bar already draws the top rule, so the list drops its own. -->
  <section
    id="panel-technical"
    role="tabpanel"
    aria-labelledby="tab-technical"
    hidden={initialTab !== 'technical'}
    class="[&_.rows]:border-t-0 [&_.rows>li:first-child]:pt-0"
  >
    <PostList posts={technical} base="/blog" emptyMessage="Nothing published yet." />
  </section>

  <section
    id="panel-personal"
    role="tabpanel"
    aria-labelledby="tab-personal"
    hidden={initialTab !== 'personal'}
    class="[&_.rows]:border-t-0 [&_.rows>li:first-child]:pt-0"
  >
    <PostList posts={personal} base="/journal" emptyMessage="Nothing published yet." />
  </section>
</BaseLayout>

<style>
  .tab-btn[aria-selected='true'] {
    border-color: var(--color-accent);
    color: var(--color-ink);
    font-weight: 500;
  }
  .tab-btn[aria-selected='false'] {
    border-color: transparent;
    color: var(--color-ink-soft);
  }
  .tab-btn[aria-selected='false']:hover {
    color: var(--color-ink);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const select = (name: string) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === name;
      tab.setAttribute('aria-selected', String(active));
      const panel = document.getElementById(`panel-${tab.dataset.tab}`);
      if (panel) panel.hidden = !active;
    });
    const url = new URL(window.location.href);
    url.searchParams.set('tab', name);
    history.replaceState(null, '', url);
  };
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => select(tab.dataset.tab as string)),
  );
</script>
