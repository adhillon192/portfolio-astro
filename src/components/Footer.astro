---
import { site, contactLinks } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--color-border)]">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-2 px-5 py-8 text-sm text-[var(--color-ink-faint)] sm:flex-row sm:items-baseline sm:justify-between"
  >
    <p>{site.name} · {site.location} · {year}</p>
    <ul class="flex flex-wrap gap-x-5">
      {
        contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="link"
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
