---
import { site, nav } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!--
  Plain masthead: name on the left, four text links on the right. Not sticky,
  no blur, no hamburger. On narrow screens the links wrap onto a second line,
  which needs no script and keeps every route one tap away.
-->
<header class="border-b border-[var(--color-border)]">
  <nav
    class="mx-auto flex max-w-3xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-5 py-5"
    aria-label="Primary"
  >
    <a href="/" class="font-medium tracking-tight text-[var(--color-ink)]">
      {site.name}
    </a>
    <ul class="flex flex-wrap gap-x-5 text-[15px]">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'underline-offset-4 transition-colors hover:text-[var(--color-ink)]',
                isActive(item.href)
                  ? 'text-[var(--color-ink)] underline decoration-[var(--color-accent)]'
                  : 'text-[var(--color-ink-soft)]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
