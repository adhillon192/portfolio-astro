---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: (CollectionEntry<'blog'> | CollectionEntry<'journal'>)[];
  /** Base path for links, e.g. "/blog" or "/journal". */
  base: string;
  emptyMessage: string;
}

const { posts, base, emptyMessage } = Astro.props;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'short', day: 'numeric' }).format(d);
---

{
  posts.length === 0 ? (
    <p class="text-sm text-[var(--color-ink-faint)]">
      {emptyMessage}
    </p>
  ) : (
    <ul class="rows">
      {posts.map((post) => (
        <li class="grid gap-y-1 py-5 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-10">
          <time datetime={post.data.date.toISOString()} class="meta md:pt-0.5">
            {fmt(post.data.date)}
          </time>
          <div>
            <h2 class="text-lg font-medium leading-snug">
              <a href={`${base}/${post.id}`} class="link">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-1.5 text-[15px] text-[var(--color-ink-soft)]">{post.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}
