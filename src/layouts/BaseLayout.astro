---
import BaseHead from '@/components/BaseHead.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  brandSuffix?: boolean;
}

const { title, description, image, brandSuffix } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} brandSuffix={brandSuffix} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-[var(--color-ink)] focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-5 pt-12 pb-8 sm:pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
