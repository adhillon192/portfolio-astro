---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  /** Where the "back" link points, e.g. "/blog" or "/journal". */
  backHref: string;
  backLabel: string;
}

const { title, description, date, tags = [], backHref, backLabel } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={description}>
  <article>
    <a
      href={backHref}
      class="text-sm text-[var(--color-ink-soft)] link-underline hover:text-[var(--color-ink)]"
    >
      ← {backLabel}
    </a>

    <header class="mt-6 mb-8 border-b border-[var(--color-border)] pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-balance">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-[var(--color-ink-faint)]">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full bg-[var(--color-accent-soft)] px-2 py-0.5 text-xs text-[var(--color-accent-ink)]">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div
      class="prose-portfolio max-w-none text-[var(--color-ink-soft)] leading-relaxed [&_a]:text-[var(--color-ink)] [&_a]:underline [&_a]:decoration-[var(--color-border-strong)] [&_a:hover]:decoration-[var(--color-accent)] [&_code]:rounded [&_code]:bg-[var(--color-base)] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.9em] [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-[var(--color-ink)] [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:font-semibold [&_h3]:text-[var(--color-ink)] [&_li]:my-1 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:my-4 [&_strong]:text-[var(--color-ink)] [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
